#---------------- HEADER ----------------
PEX25D 1.0-rc1
UNITS LENGTH um GRID 0.0001
META technology ihp-sg13g2
META source_cell overlap_plates_100um_x_100um_m1_m2
META generator "kpex 0.6.1"
META source_dbu 0.001

#---------------- GROUND PLANE ----------------
GROUND_PLANE subs Z_OFFSETS -0.28 0.0

#---------------- LAYERS (metal / via) ----------------
METAL GatPoly Z_OFFSETS 0.4 0.56
METAL Metal1 Z_OFFSETS 1.04 1.46
METAL Metal2 Z_OFFSETS 2.0 2.49
METAL Metal3 Z_OFFSETS 3.03 3.52
METAL Metal4 Z_OFFSETS 4.06 4.55
METAL metal5_n_cap Z_OFFSETS 5.09 5.58
METAL metal5_cap Z_OFFSETS 5.09 5.58
METAL cmim_top Z_OFFSETS 5.62 5.77
METAL TopMetal1 Z_OFFSETS 6.43 8.43
METAL TopMetal2 Z_OFFSETS 11.23 14.23
VIA cont_poly_con CONNECTS GatPoly Metal1
VIA via1_drw CONNECTS Metal1 Metal2
VIA via2_drw CONNECTS Metal2 Metal3
VIA via3_drw CONNECTS Metal3 Metal4
VIA via4_drw CONNECTS Metal4 metal5_n_cap
VIA topvia1_n_cap CONNECTS metal5_n_cap TopMetal1
VIA mim_via CONNECTS cmim_top TopMetal1
VIA topvia2_drw CONNECTS TopMetal1 TopMetal2

#---------------- DIELECTRICS ----------------
DIELECTRIC_SIMPLE fox WRAPS subs PERMITTIVITY 3.95 BETWEEN subs GatPoly
DIELECTRIC_CONFORMAL nitride WRAPS GatPoly PERMITTIVITY 6.5 THICKNESS_OVER_WRAPPED 0.05 \
    THICKNESS_BESIDE_WRAPPED 0.05 THICKNESS_ON_FIELD 0.05
DIELECTRIC_SIMPLE ild0 WRAPS nitride PERMITTIVITY 4.1 BETWEEN GatPoly Metal1
DIELECTRIC_SIMPLE ild1 WRAPS Metal1 PERMITTIVITY 4.1 BETWEEN Metal1 Metal2
DIELECTRIC_SIMPLE ild2 WRAPS Metal2 PERMITTIVITY 4.1 BETWEEN Metal2 Metal3
DIELECTRIC_SIMPLE ild3 WRAPS Metal3 PERMITTIVITY 4.1 BETWEEN Metal3 Metal4
DIELECTRIC_SIMPLE ild4 WRAPS Metal4 PERMITTIVITY 4.1 BETWEEN Metal4 metal5_n_cap
DIELECTRIC_SIMPLE ildtm1 WRAPS metal5_n_cap PERMITTIVITY 4.1 BETWEEN metal5_n_cap metal5_cap
DIELECTRIC_CONFORMAL ismim WRAPS metal5_cap PERMITTIVITY 6.7 THICKNESS_OVER_WRAPPED 0.04 \
    THICKNESS_BESIDE_WRAPPED 0.0 THICKNESS_ON_FIELD 0.0
DIELECTRIC_SIMPLE ildtm1b WRAPS ismim PERMITTIVITY 4.1 BETWEEN metal5_cap cmim_top
DIELECTRIC_SIMPLE ildtm1c WRAPS cmim_top PERMITTIVITY 4.1 BETWEEN cmim_top TopMetal1
DIELECTRIC_SIMPLE ildtm2 WRAPS TopMetal1 PERMITTIVITY 4.1 BETWEEN TopMetal1 TopMetal2
DIELECTRIC_CONFORMAL pass1 WRAPS TopMetal2 PERMITTIVITY 4.1 THICKNESS_OVER_WRAPPED 1.5 \
    THICKNESS_BESIDE_WRAPPED 0.3 THICKNESS_ON_FIELD 1.5
DIELECTRIC_CONFORMAL pass2 WRAPS pass1 PERMITTIVITY 6.6 THICKNESS_OVER_WRAPPED 0.4 \
    THICKNESS_BESIDE_WRAPPED 0.3 THICKNESS_ON_FIELD 0.4
DIELECTRIC_BACKGROUND air PERMITTIVITY 1.0

#---------------- RESISTANCE ----------------
RESISTANCE METAL GatPoly SHEET 7.0
RESISTANCE METAL Metal1 SHEET 0.11
RESISTANCE METAL Metal2 SHEET 0.088
RESISTANCE METAL Metal3 SHEET 0.088
RESISTANCE METAL Metal4 SHEET 0.088
RESISTANCE METAL metal5_n_cap SHEET 0.088
RESISTANCE METAL metal5_cap SHEET 0.088
RESISTANCE METAL cmim_top SHEET 13.36
RESISTANCE METAL TopMetal1 SHEET 0.018
RESISTANCE METAL TopMetal2 SHEET 0.011
RESISTANCE VIA cont_poly_con PER_CUT 15.0
RESISTANCE VIA via1_drw PER_CUT 9.0
RESISTANCE VIA via2_drw PER_CUT 9.0
RESISTANCE VIA via3_drw PER_CUT 9.0
RESISTANCE VIA via4_drw PER_CUT 9.0
RESISTANCE VIA topvia1_n_cap PER_CUT 2.2
RESISTANCE VIA mim_via PER_CUT 2.2
RESISTANCE VIA topvia2_drw PER_CUT 1.1

#---------------- NETS and SHAPES ----------------
CONDUCTOR LOWER LOWER
CONDUCTOR UPPER UPPER

BOX CONDUCTOR LOWER LAYER Metal1 LL 0.0 0.0 UR 100.0 100.0

BOX CONDUCTOR UPPER LAYER Metal2 LL 50.0 50.0 UR 150.0 150.0

#---------------- TERMINALS ----------------
TERMINAL pin:LOWER CONDUCTOR LOWER LAYER Metal1 KIND PIN LL 0.199 0.199 UR 0.201 0.201
TERMINAL pin:UPPER CONDUCTOR UPPER LAYER Metal2 KIND PIN LL 50.199 50.199 UR 50.201 50.201
